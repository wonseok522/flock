# Flock env vars, grouped by the file they belong in. Never commit real values.
# Every var below is read by the code (process.env / os.environ). Setup steps: docs/SETUP.md

# ───────────── web/.env.local (also paste into Vercel → Settings → Environment Variables) ─────────────
# The root scripts (npm run seed:* / import:luma) read this file too.
NEXT_PUBLIC_SUPABASE_URL=             # https://<project-ref>.supabase.co (Project Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # anon / publishable key; safe in the browser
SUPABASE_SERVICE_ROLE_KEY=            # service_role key: route handlers + scripts only. NEVER prefix with NEXT_PUBLIC_
NOTION_TOKEN=                         # Notion internal integration secret (ntn_...); /api/contacts reads the Safety Rules page
NOTION_RULES_PAGE_ID=                 # Safety Rules page ID; /safety contacts + "Safety rules" link on /dashboard
ZERO_WEBHOOK_URL=                     # Zero inbound webhook; /api/zero posts {event:"member.joined",...} after onboarding
GITHUB_TOKEN=                         # optional: raises the GitHub API limit for /api/verify from 60 to 5,000 req/h
GROUP_CHAT_BASELINE_SECONDS=          # optional: measured group-chat reply time shown on /dashboard (default 600)

# Scripts only (web/.env.local, not needed on Vercel)
HACK_COLLECTIVE_LUMA_CAL_ID=          # cal-... ; npm run import:luma imports late events from this calendar
LUMA_TONIGHT_EVENT_ID=evt-lN7hh5bk7fiSQvF   # tonight's event; import:luma reads venue + end time

# ───────────── bot/.env (the Flock worker on the demo laptop) ─────────────
SUPABASE_URL=                         # same value as NEXT_PUBLIC_SUPABASE_URL (required)
SUPABASE_SERVICE_ROLE_KEY=            # service_role key (required)
COGNEE_SERVICE_URL=http://localhost:8001   # the local ai-service
NOTION_TOKEN=                         # same integration secret as web
NOTION_RULES_PAGE_ID=                 # startup reachability check only
NOTION_INCIDENTS_DB_ID=               # Incidents database (schema: bot/notion-schema.md)
NOTION_DASHBOARD_DB_ID=               # Tonight dashboard database
DISCORD_BOT_TOKEN=                    # Developer Portal → Bot → Reset Token
DISCORD_GUILD_ID=                     # server ID (for the /flock slash command)
DISCORD_SESSIONS_CHANNEL_ID=          # text channel for session threads + reminders
DISCORD_ALERT_CHANNEL_ID=             # channel for missed check-in / SOS / report alerts
WEB_URL=                              # your Vercel URL, no trailing slash; used in Discord links

# ───────────── ai-service/.env (Cognee, Google Gemini) ─────────────
LLM_API_KEY=                          # free Gemini key: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-3.1-flash-lite
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_API_KEY=${LLM_API_KEY}      # same Gemini key
# Stay inside the Gemini free tier (requests per minute)
LLM_RATE_LIMIT_ENABLED=true
LLM_RATE_LIMIT_REQUESTS=10
LLM_RATE_LIMIT_INTERVAL=60
EMBEDDING_RATE_LIMIT_ENABLED=true
EMBEDDING_RATE_LIMIT_REQUESTS=40
EMBEDDING_RATE_LIMIT_INTERVAL=60

# Note: allowed university email domains live in the database
# (communities.allowed_email_domains, set in supabase/seed.sql), not in an env var.
